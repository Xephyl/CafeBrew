{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/shared/src/*"]
    },
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "apps/**/*.js",
    "apps/**/*.jsx",
    "packages/**/*.js",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "dist", "build"]
}